{
  "expo": {
    "name": "Vemori",
    "splash": {
      "image": "./assets/images/vemori-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F5FA"
    },
    "slug": "contactory",
    "version": "1.0.0",
    "scheme": "vemori",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.vemori",
      "accessesContactNotes": true
    },
    "android": {
      "package": "com.example.vemori",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/vemori-mark.png",
        "backgroundColor": "#1E1753"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Vemori uses the camera when you choose Scan Card."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Vemori lets you choose a card photo when you tap Gallery."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Vemori can add a contact to your phone when you choose Save to Phone Contacts."
        }
      ],
      [
        "expo-ocr-kit",
        {
          "cameraPermission": "Vemori uses the camera when you choose Scan Card."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d7b7f035-6520-4724-8bc7-2fed9911030a"
      }
    },
    "icon": "./assets/images/vemori-icon.png"
  }
}
