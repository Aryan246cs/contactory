    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.0",
    "expo-linking": "~57.0.12",
    "expo-ocr-kit": "^0.1.4",
    "expo-router": "~57.0.25",
    "expo-sharing": "~57.0.0",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
